[Unit]
Description=awww Wayland wallpaper daemon for Carbon
Documentation=https://codeberg.org/LGFae/awww

[Service]
Type=simple
ExecStart=/usr/bin/awww-daemon --format argb
ExecStartPost=/usr/bin/sh -c 'wallpaper=$$(cat "$${XDG_STATE_HOME:-%h/.local/state}/quickshell/user/current-wallpaper" 2>/dev/null); [ -f "$$wallpaper" ] || exit 0; for i in $$(seq 1 30); do /usr/bin/awww img "$$wallpaper" --transition-type none && exit 0; sleep 0.5; done; exit 0'
Restart=always
RestartSec=2
CacheDirectory=awww
NoNewPrivileges=true
