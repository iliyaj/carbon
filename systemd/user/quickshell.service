[Unit]
Description=Carbon Quickshell desktop shell
Documentation=https://github.com/iliyaj/carbon

[Service]
Type=simple
# Applications launched by the shell must survive a shell restart or crash.
KillMode=process
ExecStart=/usr/bin/quickshell
Restart=on-failure
RestartSec=2
Environment=QT_QPA_PLATFORM=wayland
Environment=QT_WAYLAND_DISABLE_WINDOWDECORATION=1
