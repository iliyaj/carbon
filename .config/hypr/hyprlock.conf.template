$text_color = rgba(e4e4cbFF)
$glass_color = rgba(FFFFFF55)
$entry_border_color = rgba(92918755)
$entry_color = rgba(e4e4cbFF)
$capslock_color = rgba(ba1a1aFF)
$font_family = Rubik Light
$font_family_clock = Rubik Light
$font_material_symbols = Material Symbols Rounded

background {
    color = rgba(181818FF)
    path = screenshot
    blur_passes = 0
    brightness = 1.0
}
input-field {
    monitor =
    size = 250, 50
    outline_thickness = 0
    dots_size = 0.1
    dots_spacing = 0.3
    outer_color = $entry_border_color
    inner_color = $glass_color
    font_color = $entry_color
    capslock_color = $capslock_color
    fade_on_empty = true

    position = 0, 20
    halign = center
    valign = center
    shadow_passes = 2
    shadow_size = 12
    shadow_color = rgba(00000030)
}

shape { # Clock and date glass panel
    monitor =
    size = 360, 180
    position = 0, 285
    halign = center
    valign = center
    rounding = 28
    color = $glass_color
    border_size = 1
    border_color = rgba(FFFFFF70) rgba(FFFFFF18) 90deg
    zindex = 0
    shadow_passes = 2
    shadow_size = 12
    shadow_color = rgba(00000030)
}

label { # Clock
    monitor =
    text = $TIME
    color = $text_color
    font_size = 65
    font_family = $font_family_clock
    zindex = 1

    position = 0, 300
    halign = center
    valign = center
}
label { # Date
    monitor =
    text = cmd[update:5000] date +"%A, %B %d"
    color = $text_color
    font_size = 17
    font_family = $font_family
    zindex = 1

    position = 0, 240
    halign = center
    valign = center
}

label { # User
    monitor =
    text =     $USER
    color = $text_color
    font_size = 20
    font_family = $font_family
    position = 0, 50
    halign = center
    valign = bottom
}
