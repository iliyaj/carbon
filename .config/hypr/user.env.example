# Machine-specific settings for the Hyprland config.
#
# Copy to ~/.config/hypr/user.env and edit. That file is gitignored and is the
# ONLY place machine facts belong -- no hostnames, usernames, absolute home
# paths or display models anywhere in tracked files.
#
# Every setting here has a working default, so the config runs unmodified on a
# machine with no user.env at all. Format is KEY=value; # comments ignored.

# --- Display -----------------------------------------------------------------
# The primary monitor. Defaults describe "whatever is plugged in", which is
# correct on an unknown machine but not optimal on a known one.
#   MONITOR_OUTPUT    output name from `hyprctl monitors`, e.g. DP-1, eDP-1
#   MONITOR_MODE      WIDTHxHEIGHT@HZ, or "preferred"
#   MONITOR_POSITION  XxY, or "auto"
#   MONITOR_SCALE     fractional scale, e.g. 1 or 1.25
MONITOR_OUTPUT=
MONITOR_MODE=preferred
MONITOR_POSITION=auto
MONITOR_SCALE=1

# --- Plugins -----------------------------------------------------------------
# hyprpm builds plugins into a per-user cache directory. Defaults to
# /var/cache/hyprpm/$USER/hyprland-plugins/hyprbars.so; override if hyprpm is
# configured differently. An absent file is handled: the config notifies and
# carries on without title bars.
HYPRBARS_PLUGIN=

# --- Wallpapers --------------------------------------------------------------
# Used by the lock screen and the wallpaper restore scripts. Absolute paths.
LOCK_WALLPAPER=
DESKTOP_WALLPAPER=
